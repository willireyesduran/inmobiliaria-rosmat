generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float

  type        String
  operation   String

  bedrooms    Int?
  bathrooms   Int?
  area        Float?

  address     String?
  city        String?
  province    String?

  featured    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}